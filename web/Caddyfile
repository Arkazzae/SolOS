# Sol in a browser, served by Caddy (web/Dockerfile). SOL_ADDRESS is what it answers on:
#
#   :80 (the default)          plain HTTP: right for localhost, or behind a proxy that does HTTPS
#   sol.example.org            a public name: Caddy gets and renews its certificate by itself
#   https://192.168.1.20       an address at home: Caddy's own certificate, to be trusted on each device
#
# Anything but localhost needs HTTPS: a browser keeps games (IndexedDB with SHA-1), plays sound
# (AudioWorklet) and works offline (a service worker) only on a secure page.

{$SOL_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	# Built files carry a hash in their names: kept for a year. The page, its service worker and its
	# manifest are asked again each time, so a new build reaches the players.
	@hashed path */assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh path / /index.html */ */index.html /sw.js */sw.js /manifest.webmanifest */manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	@rooms path */netplay
	handle @rooms {
		rewrite * /netplay
		reverse_proxy rooms:8788
	}
	file_server
}
